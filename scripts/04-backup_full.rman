# Script RMAN profesional.
# Cubre: retención 7 días, cifrado AES128, compresión, CDB/PDBs,
# archivelogs, controlfile, crosscheck y limpieza de obsoletos.

CONNECT TARGET /

CONFIGURE RETENTION POLICY TO RECOVERY WINDOW OF 7 DAYS;
CONFIGURE CONTROLFILE AUTOBACKUP ON;
CONFIGURE DEVICE TYPE DISK PARALLELISM 1 BACKUP TYPE TO COMPRESSED BACKUPSET;
CONFIGURE ENCRYPTION ALGORITHM 'AES128';
CONFIGURE ENCRYPTION FOR DATABASE ON;

RUN {
  SQL "ALTER SYSTEM ARCHIVE LOG CURRENT";

  CROSSCHECK BACKUP;
  CROSSCHECK ARCHIVELOG ALL;
  DELETE NOPROMPT EXPIRED BACKUP;
  DELETE NOPROMPT EXPIRED ARCHIVELOG ALL;

  BACKUP AS COMPRESSED BACKUPSET
    DATABASE PLUS ARCHIVELOG
    FORMAT '/opt/oracle/backups/full_%d_%T_%U.bkp'
    TAG 'FULL_ENCRYPTED_BACKUP';

  BACKUP CURRENT CONTROLFILE
    FORMAT '/opt/oracle/backups/controlfile_%d_%T_%U.bkp'
    TAG 'CONTROLFILE_BACKUP';

  DELETE NOPROMPT OBSOLETE;
}

LIST BACKUP SUMMARY;
