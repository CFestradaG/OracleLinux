# Copia este archivo como .env y ajusta los valores antes de ejecutar scripts.

CONTAINER_NAME=oracle-xe-backup-lab
IMAGE_NAME=cestrda/oracle-xe-custom:latest

# Contraseña SYS/SYSTEM usada por la imagen Oracle XE.
ORACLE_PASSWORD=Oracle123456

# Contraseña del Software Keystore / Wallet.
# En un proyecto real no debe quedar escrita en Git.
TDE_WALLET_PASSWORD=Wallet123456

# Conexión local dentro del contenedor.
ORACLE_SID=XE
ORACLE_SERVICE=XE

# Rutas internas del contenedor.
FRA_DIR=/opt/oracle/oradata/fast_recovery_area
WALLET_DIR=/opt/oracle/admin/XE/wallet
BACKUP_DIR=/opt/oracle/backups
LOG_DIR=/opt/oracle/backup-logs
